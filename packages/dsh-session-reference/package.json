{
  "name": "@v3887023/dsh-session-reference",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Adds a \"Reference in current chat\" row to a Session's sidebar context menu, inserting the same @session reference the composer's @ menu inserts.",
  "scripts": {
    "test": "node test/mention.test.mjs && node test/registration.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3887023/dsh-plugins.git",
    "directory": "packages/dsh-session-reference"
  },
  "homepage": "https://github.com/v3887023/dsh-plugins/tree/main/packages/dsh-session-reference"
}
