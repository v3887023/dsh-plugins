{
  "name": "@v3887023/dsh-noir-skin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Graphite + champagne theme layer for the DSH web client: re-points the alias token set through ctx.theme.overrideTokens, with three accents in Settings.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3887023/dsh-plugins.git",
    "directory": "packages/dsh-noir-skin"
  },
  "homepage": "https://github.com/v3887023/dsh-plugins/tree/main/packages/dsh-noir-skin"
}
