{
  "name": "@v3887023/dsh-bold-color",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Colors bold text (`**strong**`) inside conversation Markdown bodies.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3887023/dsh-plugins.git",
    "directory": "packages/dsh-bold-color"
  },
  "homepage": "https://github.com/v3887023/dsh-plugins/tree/main/packages/dsh-bold-color"
}
