{
  "name": "@v3887023/dsh-session-date-groups",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Groups the sidebar's single-list Sessions by date (Pinned, Today, Yesterday, then one collapsible section per calendar day), with each dated header naming its weekday.",
  "scripts": {
    "test": "node test/groups.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3887023/dsh-plugins.git",
    "directory": "packages/dsh-session-date-groups"
  },
  "homepage": "https://github.com/v3887023/dsh-plugins/tree/main/packages/dsh-session-date-groups"
}
