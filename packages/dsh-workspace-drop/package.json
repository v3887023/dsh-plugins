{
  "name": "@v3887023/dsh-workspace-drop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Superseded by @v3887023/dsh-sidebar-plus. Adds a dragged folder to Workspaces when it is dropped on the sidebar, and opens a new Session in it.",
  "scripts": {
    "test": "node test/drop.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3887023/dsh-plugins.git",
    "directory": "packages/dsh-workspace-drop"
  },
  "homepage": "https://github.com/v3887023/dsh-plugins/tree/main/packages/dsh-workspace-drop"
}
